meta {
  name: Return Caller ID
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/chat
  body: json
  auth: none
}

headers {
  X-Request-ID: bruno-a1b2c3d4
}

body:json {
  {
    "message": ""
  }
}

docs {
  Fails validation on purpose (free); error responses carry the ID too.
}

tests {
  test("returns the caller's ID unchanged", function () {
    expect(res.getStatus()).to.equal(422);
    expect(res.getHeader("x-request-id")).to.equal("bruno-a1b2c3d4");
  });
}
