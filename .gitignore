# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Secrets -- never commit
.env

# Terraform -- providers, local state and local variable values (.terraform.lock.hcl IS committed)
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars

# Local archives of the working directory (can contain .terraform/)
*.zip

# IDE / OS
.idea/
.DS_Store

# Docker Desktop build exports (unrelated to the project)
*.dockerbuild
